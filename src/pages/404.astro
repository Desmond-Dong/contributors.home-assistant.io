---
import Base from "../layouts/Base.astro";
const BASE = import.meta.env.BASE_URL;
---

<Base title="页面不存在" description="该页面不存在。">
  <main class="page" id="main-content" tabindex="-1">
    <h1>页面不存在</h1>
    <p>
      该页面不存在，或者已移动。试试顶部的搜索，或者
      从<a href={BASE}>首页</a>开始。
    </p>
  </main>
</Base>

<script is:inline>
  // Lets us find broken links in the analytics.
  if (typeof window.plausible === "function") window.plausible("404");
</script>

<style>
  .page {
    max-width: var(--site-content-width);
    margin: 0 auto;
    padding: var(--ha-space-16) var(--ha-space-6);
  }
</style>
